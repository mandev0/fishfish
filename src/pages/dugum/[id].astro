---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Bolum from '../../components/Bolum.astro';
import Liste from '../../components/Liste.astro';
import Metin from '../../components/Metin.astro';
import KnotDiagram from '../../components/svg/KnotDiagram.astro';
import Zorluk from '../../components/Zorluk.astro';
import { dugumKategoriAdi } from '../../lib/dugum';
import { baslikBicimi } from '../../lib/metin';

export async function getStaticPaths() {
  const dugumler = await getCollection('knots');
  return dugumler.map((k) => ({ params: { id: k.id }, props: { dugum: k } }));
}

const { dugum } = Astro.props;
const d = dugum.data;
const takimlar = (await getCollection('rigs')).filter((r) => r.data.dugumler.includes(dugum.id));
const gorulen = new Set<string>();
---
<Base baslik={d.ad} aciklama={d.ozet}>
  <p class="etiket-ust">{baslikBicimi(dugumKategoriAdi(d.kategori))}</p>
  <h1 class="mt-1 text-3xl sm:text-4xl">{d.ad}</h1>
  <Metin metin={d.ozet} etiket="p" sinif="mt-2 max-w-2xl" gorulen={gorulen} />

  <dl class="mt-4 grid gap-5 sm:grid-cols-3">
    <div class="kart p-4">
      <dt class="etiket-ust">Nerede Kullanılır</dt>
      <Metin metin={d.kullanim} etiket="dd" sinif="mt-1 text-sm" gorulen={gorulen} />
    </div>
    <div class="kart p-4">
      <dt class="etiket-ust">Gücü</dt>
      <dd class="mt-1 text-sm">{d.guc}</dd>
    </div>
    <div class="kart p-4">
      <dt class="etiket-ust">Zorluk</dt>
      <dd class="mt-1"><Zorluk seviye={d.zorluk} /></dd>
    </div>
  </dl>

  <div class="mt-6">
    <KnotDiagram dugum={dugum.id} />
  </div>

  <Bolum baslik="Adım Adım">
    <ol class="space-y-3">
      {d.adimlar.map((adim, i) => (
        <li class="kart flex gap-4 p-4 text-sm">
          <span class="sayisal flex size-7 shrink-0 items-center justify-center rounded-sm bg-accent text-sm font-bold text-accent-ink">{i + 1}</span>
          <Metin metin={adim} gorulen={gorulen} />
        </li>
      ))}
    </ol>
  </Bolum>

  {d.ipuclari.length > 0 && <Bolum baslik="İpuçları"><Liste maddeler={d.ipuclari} tip="ipucu" gorulen={gorulen} /></Bolum>}

  {takimlar.length > 0 && (
    <Bolum baslik="Bu Düğümün Kullanıldığı Takımlar">
      <ul class="flex flex-wrap gap-2">
        {takimlar.map((r) => (
          <li><a href={`/takim/${r.id}`} class="kart baglanti-cip">{r.data.ad}</a></li>
        ))}
      </ul>
    </Bolum>
  )}
</Base>
