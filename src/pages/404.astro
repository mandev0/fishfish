---
import Base from '../layouts/Base.astro';
---
<Base baslik="Sayfa Bulunamadı">
  <h1 class="text-3xl sm:text-4xl">Bu Sayfa Yok</h1>
  <p class="mt-2 text-muted">Aradığın sayfa taşınmış veya hiç var olmamış olabilir.</p>
  <ul class="mt-6 flex flex-wrap gap-2">
    {[
      ['Bugün Ne Tutulur?', '/'],
      ['Balık Takvimi', '/takvim'],
      ['Balıklar', '/balik'],
      ['Takımlar', '/takim'],
      ['Noktalar', '/noktalar'],
    ].map(([ad, href]) => (
      <li><a href={href} class="kart baglanti-cip">{ad}</a></li>
    ))}
  </ul>
</Base>
