---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Bolum from '../../components/Bolum.astro';
import Liste from '../../components/Liste.astro';
import Metin from '../../components/Metin.astro';
import RigDiagram from '../../components/svg/RigDiagram.astro';
import { baslikBicimi } from '../../lib/metin';

export async function getStaticPaths() {
  const ekipman = await getCollection('gear');
  return ekipman.map((e) => ({ params: { id: e.id }, props: { parca: e } }));
}

const { parca } = Astro.props;
const d = parca.data;
const kendi = `ekipman:${parca.id}`;
const gorulen = new Set<string>();

const tumTakimlar = await getCollection('rigs');
const takimlar = tumTakimlar.filter((r) => r.data.bilesenler.some((b) => b.ekipman === parca.id));
const dugumler = (await Promise.all(d.dugumler.map((k) => getEntry('knots', k)))).filter(Boolean);
const ilgili = (await Promise.all(d.ilgili.map((g) => getEntry('gear', g)))).filter(Boolean);

const KATEGORI_ADI: Record<string, string> = {
  kamis: 'Kamış', makine: 'Makine', misina: 'Misina', terminal: 'Terminal takım',
  'sahte-yem': 'Sahte yem', 'dogal-yem': 'Doğal yem', aksesuar: 'Aksesuar',
};
---
<Base baslik={d.ad} aciklama={d.ozet}>
  <nav class="mb-4 text-sm">
    <a href="/ekipman" class="text-accent hover:underline">← Tüm ekipman</a>
  </nav>

  <p class="etiket-ust">{baslikBicimi(KATEGORI_ADI[d.kategori] ?? d.kategori)}</p>
  <h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl">{baslikBicimi(d.ad)}</h1>
  {d.esAdlar.length > 0 && (
    <p class="mt-1 text-sm text-muted">Ayrıca şöyle de denir: {d.esAdlar.join(', ')}</p>
  )}
  <p class="mt-3 max-w-2xl text-lg">{d.ozet}</p>

  <Bolum baslik="Nedir">
    <div class="prose max-w-none kart p-4">
      <Metin metin={d.nedir} etiket="p" gorulen={gorulen} haric={kendi} />
    </div>
  </Bolum>

  {d.neIseYarar.length > 0 && (
    <Bolum baslik="Ne İşe Yarar">
      <Liste maddeler={d.neIseYarar} tip="ipucu" gorulen={gorulen} haric={kendi} />
    </Bolum>
  )}

  {d.nasilSecilir.length > 0 && (
    <Bolum baslik="Nasıl Seçilir">
      <div class="space-y-3">
        {d.nasilSecilir.map((n) => (
          <div class="kart p-4">
            <h3 class="font-semibold">{baslikBicimi(n.baslik)}</h3>
            <Metin metin={n.metin} etiket="p" sinif="mt-1 text-sm" gorulen={gorulen} haric={kendi} />
          </div>
        ))}
      </div>
    </Bolum>
  )}

  {d.dikkat.length > 0 && (
    <Bolum baslik="Dikkat">
      <Liste maddeler={d.dikkat} tip="hata" gorulen={gorulen} haric={kendi} />
    </Bolum>
  )}

  {dugumler.length > 0 && (
    <Bolum baslik="Bununla Kullanılan Düğümler">
      <ul class="flex flex-wrap gap-2">
        {dugumler.map((k) => (
          <li><a href={`/dugum/${k!.id}`} class="kart baglanti-cip">{k!.data.ad}</a></li>
        ))}
      </ul>
    </Bolum>
  )}

  {takimlar.length > 0 && (
    <Bolum baslik="Hangi Takımlarda Kullanılır" not="Şemada bu parçanın takımın neresinde durduğunu görebilirsin.">
      <div class="space-y-4">
        {takimlar.map((r) => {
          const b = r.data.bilesenler.find((x) => x.ekipman === parca.id)!;
          return (
            <div class="kart p-4">
              <div class="flex flex-wrap items-baseline gap-2">
                <h3 class="font-semibold">
                  <a href={`/takim/${r.id}`} class="hover:text-vurgu">{r.data.ad}</a>
                </h3>
                <span class="text-sm text-muted">— burada: {b.deger}</span>
              </div>
              <p class="mt-1 text-sm text-muted">{b.aciklama}</p>
              <div class="scroll-x mt-3">
                <div class="mx-auto max-w-[260px] text-muted"><RigDiagram sema={r.data.sema} /></div>
              </div>
            </div>
          );
        })}
      </div>
    </Bolum>
  )}

  {ilgili.length > 0 && (
    <Bolum baslik="İlgili Parçalar">
      <ul class="grid gap-3 sm:grid-cols-2">
        {ilgili.map((e) => (
          <li>
            <a href={`/ekipman/${e!.id}`} class="block h-full kart p-4 hover:border-accent">
              <span class="font-medium">{e!.data.ad}</span>
              <span class="mt-0.5 block text-sm text-muted">{e!.data.ozet}</span>
            </a>
          </li>
        ))}
      </ul>
    </Bolum>
  )}
</Base>
