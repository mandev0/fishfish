---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Bolum from '../../components/Bolum.astro';
import Liste from '../../components/Liste.astro';
import Metin from '../../components/Metin.astro';
import NoktaRozetleri from '../../components/NoktaRozetleri.astro';
import SpeciesCard from '../../components/SpeciesCard.astro';
import WeatherPanel from '../../components/WeatherPanel.astro';
import Ikon from '../../components/Ikon.astro';
import { baslikBicimi } from '../../lib/metin';
import { bolgeTamAdi, SU_ADLARI, SU_TURU } from '../../lib/season';
import { ruzgar } from '../../lib/wind';
import { mesafeKm, mesafeMetni } from '../../lib/mesafe';
import shops from '../../data/shops.json';

export async function getStaticPaths() {
  const noktalar = await getCollection('spots');
  return noktalar.map((n) => ({ params: { id: n.id }, props: { nokta: n } }));
}

const { nokta } = Astro.props;
const d = nokta.data;
const turler = (await Promise.all(d.turler.map((t) => getEntry('species', t)))).filter(Boolean);
const yontemler = (await Promise.all(d.yontemler.map((y) => getEntry('methods', y)))).filter(Boolean);
const tatliSu = SU_TURU[d.su] !== 'deniz';

// Kıyı hangi yöne bakıyorsa, o yönden gelen rüzgâr denizden kıyıya eser.
const denizdenRuzgar = ruzgar(d.kiyiYonu);
const karadanRuzgar = ruzgar(d.kiyiYonu + 180);

const gorulen = new Set<string>();

// En yakın olta malzemesi dükkânları (OpenStreetMap verisi).
const yakinDukkanlar = shops.dukkanlar
  .map((dk) => ({ ...dk, km: mesafeKm(d.lat, d.lng, dk.lat, dk.lng) }))
  .sort((a, b) => a.km - b.km)
  .slice(0, 3);

const OTOPARK_METNI: Record<string, string> = {
  kolay: 'Park yeri bulmak kolay',
  orta: 'Park yeri bulunur ama kalabalık saatlerde zorlanırsın',
  zor: 'Park yeri bulmak zor',
  yok: 'Araçla gidilemez veya park imkânı yok',
};
const KALABALIK_METNI: Record<string, string> = {
  sakin: 'Genelde sakin',
  orta: 'Orta yoğunlukta',
  kalabalik: 'Kalabalık — yer kapmak için erken git',
};
---
<Base baslik={d.ad} aciklama={d.ozet}>
  <nav class="mb-4 text-sm">
    <a href="/noktalar" class="text-accent hover:underline">← Tüm noktalar</a>
  </nav>

  <p class="flex items-center gap-1.5 text-sm font-medium bolge-metin" data-bolge={d.bolge}>
    <span class="bolge-nokta" aria-hidden="true" />{bolgeTamAdi(d.bolge)} · {SU_ADLARI[d.su]}
  </p>
  <h1 class="mt-1 text-3xl sm:text-4xl">{baslikBicimi(d.ad)}</h1>
  <Metin metin={d.ozet} etiket="p" sinif="mt-3 max-w-2xl" gorulen={gorulen} />

  <div class="mt-4" data-bolge={d.bolge}>
    <NoktaRozetleri nokta={d} genis />
  </div>

  <div class="mt-6">
    <WeatherPanel sabitNokta={nokta.id} baslik="Bu Noktada Bugün" />
  </div>

  <Bolum baslik="Burada Hangi Yöntem İşler" not={`${yontemler.length} yöntem`}>
    <ul class="grid gap-3 sm:grid-cols-2">
      {yontemler.map((y) => (
        <li>
          <a href={`/yontem/${y!.id}`} class="group flex h-full items-start gap-3 kart p-3 hover:border-accent">
            <span class="mt-0.5 shrink-0 text-vurgu"><Ikon ad={y!.data.ikon} sinif="size-5" /></span>
            <span class="min-w-0">
              <span class="block font-medium group-hover:text-accent">{y!.data.ad}</span>
              <span class="mt-0.5 block text-sm text-muted">{y!.data.ozet}</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </Bolum>

  <Bolum baslik="Pratik Bilgiler">
    <dl class="grid gap-3 sm:grid-cols-2">
      <div class="kart p-3">
        <dt class="text-xs uppercase tracking-wide text-muted">Ulaşım</dt>
        <dd class="mt-1 text-sm">{d.ulasim}</dd>
      </div>
      <div class="kart p-3">
        <dt class="text-xs uppercase tracking-wide text-muted">Otopark</dt>
        <dd class="mt-1 text-sm">{OTOPARK_METNI[d.otopark]}</dd>
      </div>
      <div class="kart p-3">
        <dt class="text-xs uppercase tracking-wide text-muted">Yoğunluk</dt>
        <dd class="mt-1 text-sm">{KALABALIK_METNI[d.kalabalik]}</dd>
      </div>
      <div class="kart p-3">
        <dt class="text-xs uppercase tracking-wide text-muted">Konum</dt>
        <dd class="mt-1 text-sm">
          <a
            class="text-accent underline"
            href={`https://www.openstreetmap.org/?mlat=${d.lat}&mlon=${d.lng}#map=16/${d.lat}/${d.lng}`}
            rel="noopener" target="_blank"
          >{d.lat.toFixed(4)}, {d.lng.toFixed(4)} — haritada aç</a>
        </dd>
      </div>
    </dl>
  </Bolum>

  <Bolum baslik="Rüzgâr ve Akıntı">
    <div class="kart p-4 text-sm">
      {tatliSu && (
        <p class="mb-3 text-muted">
          Burası tatlı su; deniz modeli bu noktayı kapsamaz. Dalga ve su sıcaklığı gösterilmez,
          skorlar bu iki faktör olmadan hesaplanır. Rüzgâr yine de önemli: göl kıyısında
          rüzgârın estiği yöne bakan kıyıda su bulanır ve balık oraya toplanır.
        </p>
      )}
      <p>
        Kıyı yaklaşık <strong>{d.kiyiYonu}°</strong> yönüne bakıyor.
        <strong>{denizdenRuzgar.ad}</strong> denizden kıyıya eser: dalga büyür, atış zorlaşır ama yem kıyıya yaklaşır.
        <strong>{karadanRuzgar.ad}</strong> karadan denize eser: su düzleşir, atış mesafen uzar.
      </p>
      {d.akintiNotu && <Metin metin={d.akintiNotu} etiket="p" sinif="mt-3" gorulen={gorulen} />}
      {d.orkoz && (
        <p class="mt-3 rounded-sm border border-l-[3px] border-vurgu/40 border-l-vurgu bg-vurgu-soft p-3">
          <strong>Orkoz bölgesi.</strong> Kuvvetli lodosta bu koyda akıntı tersine döner ve kuzeye akar.
          Yem balığı ters akıntının içinde toplanır, avcı balık peşinden gelir.
          Atıştan önce suya bir parça yem veya yosun atıp sürüklenme yönünü gözle doğrula.
        </p>
      )}
    </div>
  </Bolum>

  {d.mevzuat && (
    <Bolum baslik="Mevzuat">
      <div class="rounded-sm border border-l-[3px] border-warn/40 border-l-warn bg-warn-soft p-4">
        <p class="flex items-start gap-2 text-sm">
          <span class="mt-0.5 shrink-0 text-warn"><Ikon ad="yasak" sinif="size-4" /></span>
          <span>{d.mevzuat.metin}</span>
        </p>
        <p class="mt-2 text-xs text-muted">
          Kaynak: {d.mevzuat.kaynak} · Son kontrol: {d.mevzuat.kontrolTarihi} ·
          <a href="/kurallar" class="underline">Tüm kurallar</a>
        </p>
      </div>
    </Bolum>
  )}

  {d.tehlikeler.length > 0 && (
    <Bolum baslik="Tehlikeler">
      <Liste maddeler={d.tehlikeler} tip="hata" gorulen={gorulen} />
    </Bolum>
  )}

  {d.kisitlar.length > 0 && (
    <Bolum baslik="Kısıtlar">
      <Liste maddeler={d.kisitlar} gorulen={gorulen} />
    </Bolum>
  )}

  <Bolum baslik="En Yakın Olta Malzemecisi" not="Kuş uçuşu mesafe. Yol mesafesi daha uzun olur.">
    <ul class="grid gap-2 sm:grid-cols-3">
      {yakinDukkanlar.map((dk) => (
        <li class="kart p-3">
          <p class="font-medium">{dk.ad}</p>
          <p class="text-sm text-muted">
            {mesafeMetni(dk.km)}{dk.ilce ? ` · ${dk.ilce}` : ''}
          </p>
          {dk.telefon && <p class="mt-1 text-sm"><a class="text-accent hover:underline" href={`tel:${dk.telefon}`}>{dk.telefon}</a></p>}
          <a class="mt-1 inline-block text-xs text-accent hover:underline" href={dk.osm} rel="noopener" target="_blank">
            haritada aç →
          </a>
        </li>
      ))}
    </ul>
    <p class="mt-2 text-xs text-muted">
      Kaynak: OpenStreetMap katkıcıları (ODbL), {shops.cekilmeTarihi} tarihinde çekildi.
      Eksik veya kapanmış olabilir; <a class="underline" href="/ekipman#dukkanlar">tüm liste</a>.
    </p>
  </Bolum>

  <Bolum baslik="Burada Tutulan Balıklar" not={`${turler.length} tür`}>
    <div class="grid gap-3 sm:grid-cols-2">
      {turler.map((t) => <SpeciesCard tur={t} />)}
    </div>
  </Bolum>
</Base>
