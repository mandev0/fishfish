---
import Base from '../layouts/Base.astro';
import Ikon from '../components/Ikon.astro';
import { baslikBicimi } from '../lib/metin';
import { MENU_BOLUMLERI, BOLUMLER } from '../lib/gezinme';

/** Çevrimdışıyken de gezilebilsin diye tüm bölümler listelenir. */
const bolumler = [BOLUMLER[0]!, ...MENU_BOLUMLERI];
---
<Base
  baslik="Çevrimdışısın"
  aciklama="Bağlantı yokken açılan sayfa. Rehberin tamamı cihazda kayıtlı; canlı hava verisi ve harita bağlantı gerektirir."
>
  <h1 class="text-3xl sm:text-4xl">Çevrimdışısın</h1>
  <p class="mt-2 max-w-2xl text-muted">
    Aradığın sayfa cihazda kayıtlı değil. Rehberin geri kalanı çalışmaya devam ediyor —
    aşağıdaki başlıklardan devam edebilirsin.
  </p>

  <div class="kart kart-vurgulu mt-6 p-4">
    <h2 class="flex items-center gap-2 text-base font-semibold">
      <Ikon ad="uyari" sinif="size-[18px] shrink-0 text-vurgu" />
      Bağlantı Yokken Ne Çalışmaz?
    </h2>
    <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-muted">
      <li>
        <strong class="text-ink">Canlı hava ve deniz verisi.</strong>
        Son alınan veri gösterilir ve kaç saat önce alındığı yazar; hiç veri yoksa
        günlük tavsiye mevsime dayalı listeye düşer.
      </li>
      <li>
        <strong class="text-ink">Harita.</strong>
        Karolar ağdan gelir. Harita gizlenir, nokta listesi ve filtreler çalışmaya devam eder.
      </li>
    </ul>
  </div>

  {bolumler.map((bolum) => (
    <section class="mt-8">
      <h2 class="bolum-baslik mb-3 text-xl sm:text-2xl">{baslikBicimi(bolum.ad)}</h2>
      <ul class="grid gap-2 sm:grid-cols-2">
        {bolum.ogeler.map((oge) => (
          <li>
            <a href={oge.href} class="kart flex min-h-[3.5rem] items-center gap-3 px-3 py-2.5 transition-colors hover:border-accent">
              <span class="flex size-9 shrink-0 items-center justify-center rounded-sm bg-accent-soft text-accent" aria-hidden="true">
                <Ikon ad={oge.ikon} sinif="size-5" />
              </span>
              <span class="min-w-0">
                <span class="block font-medium">{oge.ad}</span>
                <span class="block text-sm text-muted">{oge.ipucu}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
