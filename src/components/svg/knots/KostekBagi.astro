---
import Adim from './_Adim.astro';
---
<svg class="diagram" viewBox="0 0 400 450" role="img" aria-labelledby="k-kostek">
  <title id="k-kostek">Köstek bağı: bedenin ortasında ilmek yap, ilmeği 6-8 kez döndür, sarımların ortasındaki açıklıktan ilmeği geçir ve iki ucu ters yönde çekerek sık.</title>

  <Adim no={1} baslik="Bedenin ortasında bir ilmek oluştur" y={0}>
    <path class="beden" d="M12 40 L120 40" />
    <path class="beden" d="M240 40 L388 40" />
    <path class="uc" d="M120 40 q20 44 60 44 q40 0 60 -44" />
    <text class="lbl-misina" x="150" y="100">beden kesilmez</text>
  </Adim>

  <Adim no={2} baslik="İlmeği kendi ekseninde 6-8 kez döndür" y={150}>
    <path class="beden" d="M12 40 L110 40" />
    <path class="beden" d="M250 40 L388 40" />
    {[0,1,2,3,4,5,6].map((i) => (
      <g>
        <path class="uc" d={`M${112 + i * 19} 40 q10 -16 19 0`} />
        <path class="uc" stroke-width="1.3" stroke-dasharray="3 3" d={`M${112 + i * 19} 40 q10 16 19 0`} />
      </g>
    ))}
    <circle cx="180" cy="40" r="10" class="dugum" />
    <text class="lbl-a" x="152" y="80">sarımların ortasındaki açıklık</text>
  </Adim>

  <Adim no={3} baslik="İlmeği açıklıktan geçir, uçları ters yönde çek" y={300}>
    <path class="beden" d="M12 40 L120 40" />
    <path class="beden" d="M240 40 L388 40" />
    <g transform="translate(180,40)">
      <rect x="-58" y="-11" width="116" height="22" rx="5" class="dugum-dolu" />
      {[0,1,2,3,4,5].map((i) => (<path class="ln-thin" d={`M${-44 + i * 18} -11 L${-44 + i * 18} 11`} />))}
    </g>
    <path class="lider" d="M180 11 L180 74" />
    <path class="lider" d="M180 74 q-22 0 -22 10 q0 10 22 10 q22 0 22 -10 q0 -10 -22 -10" />
    <path class="lider" stroke-width="1.5" d="M180 11 l-8 14 M180 11 l8 14" />
    <text class="lbl-lider" x="210" y="80">ilmek bedene 90° çıkar</text>
  </Adim>
</svg>
