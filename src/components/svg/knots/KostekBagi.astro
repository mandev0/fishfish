---
import Adim from './_Adim.astro';
import Burgu from './_Burgu.astro';
import Ip from './_Ip.astro';
import Ok from './_Ok.astro';
import Olcu from './_Olcu.astro';
import Sikilmis from './_Sikilmis.astro';
---
<Adim no={1} baslik="Bedenin istediğin noktasında bir ilmek oluştur; beden kesilmez.">
  <Ip d="M12 58 L118 58 C158 58 184 92 156 112" tur="beden" />
  <Ip d="M156 112 C128 130 96 100 110 78 C120 62 146 74 172 58 L308 58" tur="beden" ust />
  <text class="lbl-misina" x="12" y="146">beden bütün kalır</text>
  <text class="lbl-a" x="212" y="112">ilmek</text>
</Adim>

<Adim no={2} baslik="İlmeğin bir kolunu tutup ilmeği kendi ekseninde 6-8 kez döndür.">
  <Ip d="M12 44 L94 44" tur="beden" />
  <Ip d="M224 44 L308 44" tur="beden" />
  <Burgu x={104} y={44} adet={6} adim={20} yaricap={10} tur="beden" />
  <Ip d="M100 54 C104 108 196 108 200 54" tur="uc" />
  <text class="lbl-uc" x="150" y="126" text-anchor="middle">ilmek aşağıda kalır</text>
  <text class="lbl-a" x="308" y="76" text-anchor="end">6-8 dönüş</text>
</Adim>

<Adim no={3} baslik="Sarımların tam ortasında oluşan küçük açıklığı parmağınla aç.">
  <Ip d="M12 44 L66 44" tur="beden" />
  <Ip d="M244 44 L308 44" tur="beden" />
  <Burgu x={76} y={44} adet={3} adim={20} yaricap={10} tur="beden" />
  <Burgu x={194} y={44} adet={3} adim={20} yaricap={10} tur="beden" />
  <Ip d="M126 34 L184 34" tur="beden" />
  <Ip d="M126 54 L184 54" tur="beden" />
  <ellipse class="dugum" cx="155" cy="44" rx="32" ry="14" />
  <Ok x1={155} y1={124} x2={155} y2={68} />
  <text class="lbl-a" x="155" y="144" text-anchor="middle">ortadaki açıklık</text>
</Adim>

<Adim no={4} baslik="İlmeğin alt kısmını bu açıklığın içinden yukarı çek.">
  <Ip d="M12 60 L66 60" tur="beden" />
  <Ip d="M244 60 L308 60" tur="beden" />
  <Burgu x={76} y={60} adet={3} adim={20} yaricap={10} tur="beden" />
  <Burgu x={194} y={60} adet={3} adim={20} yaricap={10} tur="beden" />
  <Ip d="M126 50 L184 50" tur="beden" />
  <Ip d="M126 70 L184 70" tur="beden" />
  <Ip d="M144 62 C126 22 184 22 166 62" tur="uc" ust />
  <Ok x1={155} y1={128} x2={155} y2={84} />
  <text class="lbl-uc" x="172" y="140">yukarı çek</text>
</Adim>

<Adim no={5} baslik="İlmeği tutarak bedenin iki ucunu ters yönde çek; ilmek bedene 90 derece dik durur.">
  <Ip d="M12 110 L102 110" tur="beden" />
  <Ip d="M208 110 L308 110" tur="beden" />
  <Sikilmis x={155} y={110} en={106} boy={24} adet={8} />
  <Ip d="M149 98 C149 82 128 74 128 50 C128 26 182 26 182 50 C182 74 161 82 161 98" tur="uc" />
  <Ok x1={90} y1={146} x2={26} y2={146} />
  <Ok x1={220} y1={146} x2={294} y2={146} />
  <text class="lbl-a" x="196" y="92">90°</text>
  <Olcu x1={128} x2={182} y={16} metin="ilmek boyu" ustte />
</Adim>
