---
/**
 * Bir düğüm adımı: kendi kartında, kendi çizim alanında.
 *
 * Eskiden üç adım tek bir 400x450 SVG'ye sığdırılıyordu; telefonda her çizim
 * ~120 piksel yüksekliğinde kalıyor ve sarımlar okunmuyordu. Artık her adım
 * ayrı bir SVG: dar ekranda tam genişlikte, geniş ekranda iki sütun.
 *
 * Açıklama cümlesi SVG içinde değil HTML'de basılır — böylece uzun cümle
 * satır kaydırır, viewBox dışına taşamaz ve gerçek metin olarak seçilebilir.
 */
interface Props {
  no: number;
  /** Adımın cümlesi — başlık değil, cümle biçiminde. */
  baslik: string;
  /** Çizim alanının yüksekliği; varsayılan 170. */
  boy?: number;
}
const { no, baslik, boy = 170 } = Astro.props;
---
<li class="kart p-3">
  <svg class="diagram" viewBox={`0 0 320 ${boy}`} aria-hidden="true">
    <slot />
  </svg>
  <p class="mt-2 flex items-start gap-2.5 text-sm">
    <span class="sayisal mt-px flex size-6 shrink-0 items-center justify-center rounded-sm bg-accent text-xs font-bold text-accent-ink">{no}</span>
    <span class="text-muted">{baslik}</span>
  </p>
</li>
