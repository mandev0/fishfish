---
import Adim from './_Adim.astro';
import Ip from './_Ip.astro';
import Ok from './_Ok.astro';
import Olcu from './_Olcu.astro';
import Sarim from './_Sarim.astro';
import Sikilmis from './_Sikilmis.astro';
---
<Adim no={1} baslik="Örgüyü gergin tut (ayağına veya dizine dola), lideri örgüye dik konumda getir.">
  <Ip d="M12 76 L308 76" tur="orgu" />
  <Ip d="M160 22 L160 130" tur="lider" ust />
  <text class="lbl-orgu" x="12" y="62">örgü (gergin)</text>
  <text class="lbl-lider" x="172" y="126">fluorocarbon lider</text>
  <Ok x1={64} y1={100} x2={18} y2={100} />
  <Ok x1={256} y1={100} x2={302} y2={100} />
  <text class="lbl" x="160" y="152" text-anchor="middle">gerginlik sabit kalmalı</text>
</Adim>

<Adim no={2} baslik="Örgüyü liderin etrafında dönüşümlü olarak alttan ve üstten geçir; 20-24 geçiş yeterli.">
  <Ip d="M14 44 Q50 44 68 60" tur="orgu" />
  <Sarim x={80} y={74} adet={8} adim={24} yaricap={14} tur="orgu">
    <Ip d="M14 74 L306 74" tur="lider" />
  </Sarim>
  <Ip d="M260 60 Q284 52 306 58" tur="orgu" />
  <text class="lbl-orgu" x="40" y="34" text-anchor="middle">örgü</text>
  <text class="lbl-lider" x="306" y="96" text-anchor="end">lider</text>
  <Olcu x1={68} x2={260} y={112} metin="20-24 geçiş" sinif="lbl-orgu" />
</Adim>

<Adim no={3} baslik="Sarımların üstüne örgünün serbest ucuyla iki kez yarım düğüm atarak kilitle.">
  <Ip d="M12 92 L80 92 Q95 92 97 63" tur="orgu" />
  <Sarim x={104} y={74} adet={7} adim={14} yaricap={11} tur="orgu">
    <Ip d="M84 74 L200 74" tur="lider" />
  </Sarim>
  <Ip d="M200 74 L306 74" tur="lider" />
  <Ip d="M195 63 C216 56 236 64 236 76 C236 88 218 92 210 82" tur="orgu" ust />
  <Ip d="M210 82 C224 92 250 88 252 74 C254 60 236 56 228 64" tur="orgu" ust />
  <text class="lbl-orgu" x="306" y="112" text-anchor="end">kilit yarım düğümler</text>
  <text class="lbl-lider" x="12" y="126">lider ucu</text>
</Adim>

<Adim no={4} baslik="Düğümü iyice ıslat ve yavaşça sıkıştır; sarımların lidere gömüldüğünü gör.">
  <Ip d="M12 74 L104 74" tur="orgu" />
  <Ip d="M216 74 L306 74" tur="lider" />
  <Sikilmis x={160} y={74} en={112} boy={20} adet={9} />
  <text class="lbl-a" x="160" y="112" text-anchor="middle">ince kalır</text>
  <Ok x1={92} y1={136} x2={20} y2={136} />
  <Ok x1={228} y1={136} x2={300} y2={136} />
  <text class="lbl" x="160" y="152" text-anchor="middle">kamış halkasından pürüzsüz geçer</text>
</Adim>

<Adim no={5} baslik="Lider fazlalığını 1-2 mm bırakarak, örgü fazlalığını dibinden kes.">
  <Ip d="M12 84 L104 84" tur="orgu" />
  <Ip d="M216 84 L306 84" tur="lider" />
  <Sikilmis x={160} y={84} en={112} boy={20} adet={9} />
  <Ip d="M216 76 L228 64" tur="lider" />
  <Olcu x1={216} x2={228} y={50} metin="1-2 mm" ustte />
  <Ip d="M104 92 L114 102" tur="orgu" />
  <text class="lbl-orgu" x="106" y="128">dibinden kes</text>
</Adim>
