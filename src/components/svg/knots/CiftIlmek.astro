---
import Adim from './_Adim.astro';
---
<svg class="diagram" viewBox="0 0 400 450" role="img" aria-labelledby="k-cift">
  <title id="k-cift">Çift ilmek: misinayı katlayarak çift hat yap, basit bir ilmek at, katlanmış ucu bu ilmekten iki kez geçir ve sık.</title>

  <Adim no={1} baslik="Ucu 15 cm katlayarak çift hat oluştur" y={0}>
    <path class="misina" d="M388 40 L120 40" />
    <path class="misina" d="M388 54 L120 54" />
    <path class="uc" d="M120 40 q-34 0 -34 7 q0 7 34 7" />
    <text class="lbl-misina" x="140" y="86">çift hat</text>
  </Adim>

  <Adim no={2} baslik="İlmek yap, katlanmış ucu İKİ kez geçir" y={150}>
    <path class="misina" d="M388 46 L214 46" />
    <path class="misina" d="M388 58 L214 58" />
    <path class="uc" d="M214 46 q-56 -14 -78 10 q-22 24 8 34 q30 10 46 -12 q16 -22 -12 -32" />
    <path class="hareket" d="M178 46 q-40 -4 -56 8 q-16 12 4 20" />
    <text class="lbl-a" x="30" y="96">iki geçiş</text>
  </Adim>

  <Adim no={3} baslik="Dört ucu birden çekerek sık — 3-5 cm ilmek kalsın" y={300}>
    <path class="misina" d="M388 46 L180 46" />
    <path class="misina" d="M388 58 L180 58" />
    <g transform="translate(158,52)">
      <rect x="-18" y="-14" width="36" height="28" rx="5" class="dugum-dolu" />
      <path class="ln-thin" stroke="var(--d-dugum)" d="M-8 -14 L-8 14 M2 -14 L2 14" />
    </g>
    <path class="uc" d="M140 46 q-46 -4 -46 6 q0 10 46 6" />
    <path class="tick" d="M94 78 L140 78" />
    <path class="tick" d="M94 72 L94 84 M140 72 L140 84" />
    <text class="lbl" x="94" y="98">3-5 cm</text>
  </Adim>
</svg>
