---
import Adim from './_Adim.astro';
import Igne from './_Igne.astro';
import Ip from './_Ip.astro';
import Ok from './_Ok.astro';
import Sarim from './_Sarim.astro';
import Sikilmis from './_Sikilmis.astro';
---
<Adim no={1} baslik="Misinanın ucunu iğnenin gözünden, iğne ucu tarafına doğru geçir.">
  <Ip d="M312 26 L132 26" tur="misina" />
  <Ip d="M132 30 C122 36 124 46 136 50 L188 74" tur="uc" />
  <Igne x={132} y={30} olcek={1.05} />
  <text class="lbl-misina" x="312" y="14" text-anchor="end">ana misina</text>
  <text class="lbl-metal" x="104" y="26" text-anchor="end">göz</text>
  <text class="lbl-uc" x="196" y="84">iğne ucuna doğru</text>
</Adim>

<Adim no={2} baslik="Bir ilmek bırakarak ucu tekrar aynı gözden ters yönde geçir.">
  <Ip d="M312 26 L200 26" tur="misina" />
  <Ip d="M200 32 C184 44 148 50 118 44 C78 36 62 66 88 80" tur="uc" />
  <Ip d="M88 80 C118 94 158 82 182 60 L198 36" tur="uc" ust />
  <Igne x={200} y={30} />
  <text class="lbl-uc" x="76" y="112" text-anchor="middle">ilmek</text>
</Adim>

<Adim no={3} baslik="İlmeğin misinasını iğnenin pipo kısmına doğru 6-8 tur sar.">
  <Ip d="M312 22 L200 22" tur="misina" />
  <Ip d="M188 40 C154 34 140 58 156 72 C170 84 190 78 196 68" tur="uc" />
  <Sarim x={200} y={42} adet={6} adim={6.5} yaricap={10} aci={90} tur="uc">
    <Igne x={200} y={26} />
  </Sarim>
  <text class="lbl-uc" x="248" y="52">6-8 tur</text>
  <text class="lbl-a" x="248" y="76">göze doğru</text>
</Adim>

<Adim no={4} baslik="Serbest kalan ana misinayı yavaşça çek; sarımlar pipoya oturur.">
  <Ip d="M312 22 L200 22" tur="misina" />
  <Igne x={200} y={26} />
  <Sikilmis x={200} y={58} en={44} boy={20} adet={5} donme={90} />
  <Ok x1={248} y1={40} x2={304} y2={30} />
  <text class="lbl" x="306" y="70" text-anchor="end">ana misinayı çek</text>
</Adim>

<Adim no={5} baslik="Islat ve tam sık; misina iğneye 180 derece hizalı çıkmalı.">
  <path class="ln-dash" d="M20 88 L300 88" />
  <Ip d="M20 88 L190 88" tur="misina" />
  <Igne x={190} y={88} donme={-90} olcek={0.95} />
  <Sikilmis x={222} y={88} en={46} boy={20} adet={5} />
  <text class="lbl-a" x="110" y="112" text-anchor="middle">180° hizalı</text>
  <text class="lbl-igne" x="286" y="146" text-anchor="end">iğne ucu</text>
</Adim>
