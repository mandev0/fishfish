---
// Yüzey spin — maket balık (minnow), sualtı süzülme yolu.
---
<svg class="diagram" viewBox="0 0 380 480" role="img" aria-labelledby="spin-baslik">
  <title id="spin-baslik">Yüzey spin takımı: ince örgü, FG düğümü, fluorocarbon lider, klips ve dalgıçlı maket balık; altında duraklamalı sarma yolu.</title>

  <rect class="water" x="0" y="120" width="380" height="360" />
  <path class="ln-thin" d="M0 120 q20 -6 40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0" />

  <path class="kamis" d="M18 26 L104 40" />
  <text class="lbl-b" x="18" y="18">Kamış 2,1-2,7 m · 7-30 gr</text>

  <path class="orgu" d="M104 40 L152 100" />
  <text class="lbl-orgu" x="168" y="76">Örgü PE 0,6-1,0</text>

  <g transform="translate(152,104)">
    <path class="orgu" d="M0 0 L0 34" />
    {[0,1,2,3,4,5].map((i) => (<path class="dugum" stroke-width="1.3" d={`M-6 ${5 + i * 5}  q6 -3 12 0`} />))}
    <circle class="dugum" cx="0" cy="17" r="13" />
  </g>
  <text class="lbl-a" x="182" y="124">FG düğümü</text>

  <path class="lider" d="M152 140 L152 216" />
  <text class="lbl-lider" x="168" y="180">Fluorocarbon lider 1 m</text>
  <text class="lbl" x="168" y="194">0,26-0,35 mm</text>

  <path class="metal" fill="none" stroke-width="2" d="M146 216 c-5 5 -5 15 6 15 c11 0 11 -10 6 -15" />
  <text class="lbl-metal" x="172" y="230">Klips</text>

  <!-- Maket balık -->
  <g transform="translate(152,258)">
    <path class="yem" d="M-48 0 c16 -20 62 -20 80 0 c-18 20 -64 20 -80 0 z" />
    <circle class="solid" cx="-34" cy="-3" r="2.6" />
    <path class="yem" d="M32 0 l16 -12 l0 24 z" />
    <!-- dalgıç (lip) -->
    <path class="lider" d="M-48 0 l-14 12" stroke-width="2.6" />
    <!-- üçlüler -->
    <path class="igne" d="M-16 8 l0 8 a5 5 0 1 0 8 3" />
    <path class="igne" d="M14 8 l0 8 a5 5 0 1 0 8 3" />
  </g>
  <text class="lbl-yem" x="212" y="252">Minnow maket</text>
  <text class="lbl" x="212" y="266">7-12 cm</text>
  <text class="lbl-lider" x="212" y="286">Dalgıç (lip) maketi</text>
  <text class="lbl-lider" x="212" y="300">suya batırır</text>

  <!-- Sarma yolu -->
  <path class="hareket" d="M330 340 q-40 24 -80 0 q-40 -24 -80 0 q-40 24 -80 0 q-30 -18 -56 -4" />
  <text class="lbl-a" x="26" y="392">3 tur sar → dur → 2 tur sar</text>
  <text class="lbl" x="26" y="408">Düz sarma değil, ritim değiştir.</text>
  <text class="lbl" x="26" y="428">Vuruş çoğu zaman duraklama anında gelir.</text>
</svg>
