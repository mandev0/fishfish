---
// Tatlı su spin takımı — örgü misina, FG düğümü, klipsli fırdöndü, çelik lider, döner kaşık.
---
<svg class="diagram" viewBox="0 0 380 500" role="img" aria-labelledby="spin-tatli-baslik">
  <title id="spin-tatli-baslik">Tatlı su spin takımı şeması: örgü ana misina, FG düğümü, klipsli fırdöndü, turnanın dişine karşı çelik lider ve dönen kanatlı döner kaşık.</title>

  <rect class="water" x="0" y="70" width="380" height="430" />
  <path class="ln-thin" d="M0 70 q20 -6 40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0" />

  <path class="kamis" d="M14 30 L118 44" />
  <text class="lbl-b" x="14" y="20">Kamış 1,9-2,4 m, 5-25 gr</text>

  <path class="orgu" d="M118 44 L176 132" />
  <text class="lbl-orgu" x="200" y="98">Örgü ana misina</text>
  <text class="lbl" x="200" y="112">PE 0,8-1,2</text>

  <!-- FG düğümü -->
  <path class="dugum" d="M167 144 q9 -9 18 0 q-9 9 -18 0 z" />
  <text class="lbl-a" x="200" y="148">FG düğümü</text>

  <!-- Klipsli fırdöndü -->
  <ellipse class="metal" cx="176" cy="182" rx="6" ry="10" />
  <path class="misina" d="M176 152 L176 172" />
  <text class="lbl-metal" x="200" y="180">Klipsli fırdöndü</text>
  <text class="lbl-a" x="196" y="198">Döner kaşık misinayı burar;</text>
  <text class="lbl-a" x="196" y="212">fırdöndüsüz misina kıvrılır</text>

  <!-- Çelik lider -->
  <path class="lider" d="M176 192 L176 300" stroke-dasharray="1 5" stroke-width="3" />
  <path class="tick" d="M132 192 L132 300 M126 192 L138 192 M126 300 L138 300" />
  <text class="lbl-lider" x="118" y="228" text-anchor="end">Çelik lider</text>
  <text class="lbl" x="118" y="242" text-anchor="end">25-40 cm, 7-10 kg</text>
  <text class="lbl-a" x="118" y="262" text-anchor="end">Turnanın dişi</text>
  <text class="lbl-a" x="118" y="276" text-anchor="end">misinayı keser</text>

  <!-- Klips -->
  <path class="metal" d="M170 300 h12 v14 h-12 z" />
  <text class="lbl-metal" x="200" y="312">Klips</text>
  <text class="lbl" x="200" y="326">yemi hızlı değiştirirsin</text>

  <!-- Döner kaşık -->
  <g transform="translate(176,352)">
    <path class="metal" d="M0 -38 L0 34" stroke-width="2" />
    <path class="metal" d="M0 -22 q22 4 24 22 q-20 6 -24 -8 z" />
    <path class="hareket" d="M30 -12 q10 12 -2 26" />
    <circle class="metal" cx="0" cy="6" r="6" />
    <circle class="metal" cx="0" cy="18" r="5" />
    <path class="igne" d="M0 34 l-11 13 M0 34 l11 13 M0 34 l0 16" />
  </g>
  <text class="lbl-metal" x="216" y="346">Dönen kanat</text>
  <text class="lbl-a" x="216" y="364">Sararken pervane gibi</text>
  <text class="lbl-a" x="216" y="378">döner: hem parıldar</text>
  <text class="lbl-a" x="216" y="392">hem titreşim yayar</text>
  <text class="lbl-igne" x="128" y="400" text-anchor="end">Üç iğne</text>
  <path class="tick" d="M134 396 L162 396" />

  <text class="lbl" x="14" y="440">Sazlık kenarını ve batık ağaçların çevresini tara —</text>
  <text class="lbl" x="14" y="458">turna açıkta gezmez, pusuda bekler.</text>
  <text class="lbl" x="14" y="482">Bulanık suda döner kaşık, berrak suda maket balık.</text>
</svg>
