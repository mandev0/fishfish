---
// Surf takımı — şok lideri, fırdöndü, beden, atış klipsine kilitlenen iğne, tırnaklı kurşun.
---
<svg class="diagram" viewBox="0 0 380 560" role="img" aria-labelledby="surf-baslik">
  <title id="surf-baslik">Surf takımı şeması: uzun kamış, kalın şok lideri, fırdöndü, beden, atış klipsine kilitlenen iğne ve kumda tutunan tırnaklı kurşun.</title>

  <rect class="water" x="0" y="78" width="380" height="482" />
  <path class="ln-thin" d="M0 78 q20 -6 40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0" />

  <path class="kamis" d="M16 26 L122 44" />
  <text class="lbl-b" x="16" y="18">Surf kamışı 3,9-4,5 m</text>

  <path class="misina" d="M122 44 L172 118" />
  <text class="lbl-misina" x="196" y="92">Ana misina</text>
  <text class="lbl" x="196" y="106">0,28-0,35 mm</text>

  <!-- Şok lideri düğümü -->
  <path class="dugum" d="M163 130 q9 -9 18 0 q-9 9 -18 0 z" />
  <text class="lbl-a" x="196" y="134">FG düğümü</text>

  <path class="lider" d="M172 138 L172 236" />
  <path class="tick" d="M132 138 L132 236 M126 138 L138 138 M126 236 L138 236" />
  <text class="lbl-lider" x="118" y="170" text-anchor="end">Şok lideri</text>
  <text class="lbl" x="118" y="184" text-anchor="end">0,55-0,60 mm</text>
  <text class="lbl-a" x="118" y="206" text-anchor="end">Atış yükünü</text>
  <text class="lbl-a" x="118" y="220" text-anchor="end">bu bölüm taşır</text>

  <!-- Fırdöndü -->
  <ellipse class="metal" cx="172" cy="248" rx="6" ry="10" />
  <text class="lbl-metal" x="196" y="252">Fırdöndü</text>

  <!-- Beden -->
  <path class="beden" d="M172 258 L172 424" />
  <text class="lbl-misina" x="196" y="292">Beden 0,50 mm</text>

  <!-- Köstek bağı ve köstek -->
  <circle class="dugum" cx="172" cy="306" r="7" />
  <text class="lbl-a" x="196" y="310">Köstek bağı</text>
  <path class="lider" d="M172 313 L108 392" />
  <text class="lbl-lider" x="96" y="352" text-anchor="end">Köstek</text>
  <text class="lbl" x="96" y="366" text-anchor="end">0,30-0,35 mm</text>
  <text class="lbl" x="96" y="380" text-anchor="end">40-60 cm</text>

  <!-- İğne ve yem -->
  <g transform="translate(108,392)">
    <path class="igne" d="M0 0 l0 16 a9 9 0 1 0 14 4" />
    <path class="uc" d="M2 6 q10 4 12 14 q2 10 -4 16" />
  </g>
  <text class="lbl-igne" x="14" y="424">İğne 1/0-3/0</text>
  <text class="lbl-yem" x="14" y="438">deniz solucanı</text>

  <!-- Atış klipsi -->
  <path class="metal" d="M166 372 h12 v14 h-12 z" />
  <path class="hareket" d="M124 400 q26 -18 44 -22" />
  <text class="lbl-a" x="196" y="376">Atışta iğne</text>
  <text class="lbl-a" x="196" y="390">buraya kilitlenir</text>
  <text class="lbl" x="196" y="406">Kurşun dibe çarpınca</text>
  <text class="lbl" x="196" y="420">kendiliğinden açılır</text>

  <!-- Kumluk dip -->
  <path class="ground" d="M0 476 q40 -14 80 -4 q40 10 80 -6 q40 -16 80 -2 q40 16 80 -6 q20 -10 40 -4 L380 560 L0 560 z" />
  <path class="ln-thin" d="M0 476 q40 -14 80 -4 q40 10 80 -6 q40 -16 80 -2 q40 16 80 -6 q20 -10 40 -4" />

  <!-- Tırnaklı kurşun -->
  <g transform="translate(172,430)">
    <path class="metal" d="M-13 0 h26 l-5 30 h-16 z" />
    <path class="ln" d="M-9 30 q-14 10 -20 22 M9 30 q14 10 20 22" />
  </g>
  <text class="lbl-metal" x="216" y="440">Tırnaklı kurşun</text>
  <text class="lbl" x="216" y="454">100-150 gr</text>
  <text class="lbl-a" x="216" y="484">Tırnaklar kumda</text>
  <text class="lbl-a" x="216" y="498">tutunur, dalga</text>
  <text class="lbl-a" x="216" y="512">takımı sürüklemez</text>

  <text class="lbl" x="14" y="540">Kurşun oturunca misinayı gerdir,</text>
  <text class="lbl" x="14" y="554">kamışı yüksek sehpaya dik.</text>
</svg>
