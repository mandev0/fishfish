---
// Sazan takımı — kayar armut kurşun, boncuk, fırdöndü, kısa köstek, mısırlı iğne.
---
<svg class="diagram" viewBox="0 0 380 520" role="img" aria-labelledby="sazan-baslik">
  <title id="sazan-baslik">Sazan takımı şeması: misinanın üstünde kayan armut kurşun, boncuk, fırdöndü, kısa köstek ve mısır takılı iğne.</title>

  <rect class="water" x="0" y="72" width="380" height="448" />
  <path class="ln-thin" d="M0 72 q20 -6 40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0 t40 0" />

  <path class="kamis" d="M16 28 L118 44" />
  <text class="lbl-b" x="16" y="20">Kamış 3,0-3,6 m, 40-100 gr</text>

  <path class="misina" d="M118 44 L172 130" />
  <text class="lbl-misina" x="196" y="100">Ana misina</text>
  <text class="lbl" x="196" y="114">0,28-0,35 mm mono</text>

  <!-- Kayar armut kurşun -->
  <g transform="translate(172,178)">
    <path class="metal" d="M0 -30 c15 0 24 16 24 33 c0 16 -11 26 -24 26 c-13 0 -24 -10 -24 -26 c0 -17 9 -33 24 -33 z" />
    <path class="misina" d="M0 -30 L0 30" />
  </g>
  <text class="lbl-metal" x="212" y="172">Kayar armut kurşun</text>
  <text class="lbl" x="212" y="186">30-80 gr</text>
  <text class="lbl-a" x="212" y="206">Misina içinden geçer;</text>
  <text class="lbl-a" x="212" y="220">sazan yemi çekerken</text>
  <text class="lbl-a" x="212" y="234">ağırlığı hissetmez</text>

  <!-- Boncuk -->
  <circle class="metal" cx="172" cy="224" r="7" />
  <text class="lbl-metal" x="128" y="226" text-anchor="end">Boncuk</text>
  <path class="tick" d="M134 224 L162 224" />
  <text class="lbl" x="128" y="240" text-anchor="end">düğümü korur</text>

  <!-- Fırdöndü -->
  <ellipse class="metal" cx="172" cy="256" rx="6" ry="10" />
  <text class="lbl-metal" x="128" y="260" text-anchor="end">Fırdöndü</text>
  <path class="tick" d="M134 256 L164 256" />

  <!-- Kısa köstek -->
  <path class="lider" d="M172 266 L172 364" />
  <path class="tick" d="M124 266 L124 364 M118 266 L130 266 M118 364 L130 364" />
  <text class="lbl-lider" x="110" y="300" text-anchor="end">Köstek</text>
  <text class="lbl" x="110" y="314" text-anchor="end">0,25-0,30 mm</text>
  <text class="lbl" x="110" y="328" text-anchor="end">20-35 cm</text>
  <text class="lbl-a" x="110" y="348" text-anchor="end">Kısa köstek</text>
  <text class="lbl-a" x="110" y="362" text-anchor="end">iğneyi kendi</text>
  <text class="lbl-a" x="110" y="376" text-anchor="end">kendine oturtur</text>

  <!-- Göl dibi ve otlar -->
  <path class="ground" d="M0 428 q40 -12 80 -4 q40 12 80 -6 q40 -16 80 -2 q40 16 80 -6 q20 -10 40 -2 L380 520 L0 520 z" />
  <path class="ln-thin" d="M0 428 q40 -12 80 -4 q40 12 80 -6 q40 -16 80 -2 q40 16 80 -6 q20 -10 40 -2" />
  <path class="ln-thin" d="M46 428 q-4 -18 2 -30 M58 430 q4 -16 -1 -26 M76 430 q-3 -14 1 -22" />

  <!-- İğne ve mısır -->
  <g transform="translate(172,368)">
    <path class="igne" d="M0 0 l0 16 a9 9 0 1 0 14 4" />
    <circle class="yem" cx="4" cy="18" r="7" />
    <circle class="yem" cx="12" cy="24" r="7" />
    <circle class="yem" cx="19" cy="30" r="7" />
  </g>
  <text class="lbl-igne" x="216" y="384">İğne 4-8 no</text>
  <text class="lbl" x="216" y="398">kalın telli</text>
  <text class="lbl-yem" x="216" y="416">3-4 tane mısır</text>
  <text class="lbl-a" x="216" y="436">İğnenin ucu</text>
  <text class="lbl-a" x="216" y="450">yemden dışarıda kalsın</text>

  <text class="lbl" x="14" y="486">Sazan yemi alıp yürür: kamış tam yay yaptığında tokatla.</text>
  <text class="lbl" x="14" y="504">Erken tokatlama iğneyi ağızdan çeker.</text>
</svg>
