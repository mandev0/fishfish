---
// Zoka atma takımı — örgü ana misina, FG düğüm, fluoro şok lideri, klips, metal zoka.
---
<svg class="diagram" viewBox="0 0 380 560" role="img" aria-labelledby="zoka-baslik">
  <title id="zoka-baslik">Zoka atma takımı: örgü ana misina, FG düğümü, fluorocarbon şok lideri, kilitli klips ve metal zoka.</title>

  <path class="kamis" d="M20 34 L120 52" />
  <circle class="metal" cx="120" cy="52" r="5" />
  <text class="lbl-b" x="20" y="24">Kamış ucu</text>
  <text class="lbl" x="20" y="70">2,4-3,0 m · 20-60 gr</text>

  <path class="orgu" d="M120 52 L168 120" />
  <text class="lbl-orgu" x="186" y="96">Örgü ana misina</text>
  <text class="lbl" x="186" y="110">PE 1,0-1,5</text>

  <!-- FG düğümü: sarımlı birleşim -->
  <g transform="translate(168,124)">
    <path class="orgu" d="M0 0 L0 44" />
    {[0,1,2,3,4,5,6].map((i) => (
      <path class="dugum" stroke-width="1.3" d={`M-7 ${6 + i * 5.5} q7 -3 14 0`} />
    ))}
    <circle class="dugum" cx="0" cy="22" r="15" />
  </g>
  <text class="lbl-a" x="202" y="146">FG düğümü</text>
  <text class="lbl" x="202" y="160">örgü ↔ fluorocarbon</text>

  <!-- Şok lideri -->
  <path class="lider" d="M168 168 L168 372" />
  <path class="tick" d="M120 168 L120 372" />
  <path class="tick" d="M114 168 L126 168 M114 372 L126 372" />
  <text class="lbl-lider" x="34" y="262">Şok lideri</text>
  <text class="lbl" x="34" y="276">1-1,5 m</text>
  <text class="lbl" x="34" y="290">fluorocarbon</text>
  <text class="lbl" x="34" y="304">0,35-0,45 mm</text>

  <!-- Klips -->
  <path class="metal" fill="none" stroke-width="2" d="M162 372 c-6 6 -6 18 6 18 c12 0 12 -12 6 -18" />
  <text class="lbl-metal" x="196" y="386">Kilitli klips</text>
  <text class="lbl" x="196" y="400">zokayı düğüm açmadan değiştirir</text>

  <!-- Zoka gövdesi -->
  <g transform="translate(168,398)">
    <path class="metal" d="M0 0 c12 6 18 26 14 52 c-3 20 -10 32 -14 40 c-4 -8 -11 -20 -14 -40 c-4 -26 2 -46 14 -52 z" />
    <path class="ln-thin" stroke="var(--d-metal-cizgi)" d="M-6 22 L6 22 M-7 34 L7 34 M-6 46 L6 46" />
    <!-- üçlü iğne -->
    <path class="igne" d="M0 92 L0 104" />
    <path class="igne" d="M0 104 l0 8 a6 6 0 1 0 10 3" />
    <path class="igne" d="M0 104 l0 8 a6 6 0 1 1 -10 3" />
  </g>
  <text class="lbl-metal" x="212" y="450">Metal zoka</text>
  <text class="lbl" x="212" y="464">20-60 gr, gümüş/mavi</text>
  <text class="lbl" x="212" y="484">Rüzgâra ve mesafeye</text>
  <text class="lbl" x="212" y="498">göre gram seç</text>

  <!-- Sarma hareketi -->
  <path class="hareket" d="M60 470 q24 -16 48 0 q24 16 48 0" />
  <text class="lbl-a" x="60" y="500">Sararken kamış ucunu</text>
  <text class="lbl-a" x="60" y="514">arada sars: yaralı balık taklidi</text>
</svg>
