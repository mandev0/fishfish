---
import { baslikBicimi } from '../lib/metin';
/** Bölüm başlıkları başlık biçimindedir; alt not cümle biçiminde kalır. */
interface Props { baslik: string; id?: string; not?: string }
const { baslik, id, not } = Astro.props;
---
<section id={id} class="mt-10 scroll-mt-20">
  <h2 class="bolum-baslik mb-1 text-xl sm:text-2xl">{baslikBicimi(baslik)}</h2>
  {not && <p class="mb-3 mt-2 text-sm text-muted">{not}</p>}
  <div class={not ? '' : 'mt-3'}><slot /></div>
</section>
