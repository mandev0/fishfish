---
import { getCollection } from 'astro:content';
import Ikon from './Ikon.astro';
import { baslikBicimi } from '../lib/metin';
import { BOLGE_ADLARI, IL_ADLARI, SAAT_ADLARI, SU_TURU } from '../lib/season';

interface Props {
  /** Verilirse panel bu noktaya kilitlenir, seçici gösterilmez. */
  sabitNokta?: string;
  baslik?: string;
}
const { sabitNokta, baslik = 'Bugün Ne Tutulur?' } = Astro.props;

const noktalar = await getCollection('spots');
// Tür koleksiyonu glob ile okunuyor ve sırası dosya sistemine göre değişiyor.
// Kimliğe göre sıralamak derlemeyi yeniden üretilebilir kılıyor: aksi hâlde
// aynı kaynaktan farklı çıktı çıkıyor, service worker sürüm damgası değişiyor
// ve kurulu kullanıcılar boş yere bütün paketi yeniden indiriyor.
const turler = (await getCollection('species')).sort((a, b) => a.id.localeCompare(b.id));
// Karar kartı "ne götürüyorsun" satırlarını ve yöntem adını takımdan okur.
const takimlar = (await getCollection('rigs')).sort((a, b) => a.id.localeCompare(b.id));
const yontemler = (await getCollection('methods')).sort((a, b) => a.id.localeCompare(b.id));

/** Türün birincil takımı ve o takımın yöntemi — karar kartının "nasıl"ı. */
function birincilTakim(t: (typeof turler)[number]) {
  const takim = takimlar.find((r) => r.id === t.data.takimlar[0]);
  const yontem = takim && yontemler.find((y) => y.id === takim.data.yontem);
  return { takimAd: takim?.data.ad ?? null, yontemAd: yontem?.data.ad ?? null, takimId: takim?.id ?? null };
}

// İstemciye sadece skor için gereken alanları gönderiyoruz.
const veri = {
  noktalar: noktalar.map((n) => ({
    id: n.id, ad: n.data.ad, bolge: n.data.bolge,
    il: n.data.il,
    lat: n.data.lat, lng: n.data.lng, kiyiYonu: n.data.kiyiYonu,
    turler: n.data.turler, denizVerisiZayif: n.data.denizVerisiZayif,
    // Tatlı suda deniz modeli hiç veri döndürmez; panel bunu farklı anlatır.
    tatliSu: SU_TURU[n.data.su] !== 'deniz',
  })),
  turler: turler.map((t) => {
    const { takimAd, yontemAd, takimId } = birincilTakim(t);
    const e = t.data.ekipman;
    return {
      id: t.id, ad: t.data.ad, ozet: t.data.ozet,
      aylar: t.data.aylar, gece: t.data.gece,
      suSicakligi: t.data.suSicakligi, aktifSaatler: t.data.aktifSaatler,
      ruzgarTercihi: t.data.ruzgarTercihi, ruzgarKacinilan: t.data.ruzgarKacinilan,
      // — Karar kartı alanları —
      takimAd, yontemAd, takimId,
      /** Nerede aranacağı: yaşam alanı cümlesinin ilk yargısı yeter. */
      nerede: (t.data.yasamAlani.split(/(?<=\.)\s/)[0] ?? t.data.yasamAlani).trim(),
      saatler: t.data.aktifSaatler.map((x: string) => SAAT_ADLARI[x] ?? x),
      /** Yasal boy hafızadan değil, kaynaklı veriden. Yoksa null. */
      asgariBoy: t.data.yasal?.asgariBoy ?? null,
      ekipman: [
        ['Kamış', e.kamis?.deger], ['Makine', e.makine?.deger],
        ['Ana misina', e.anaMisina?.deger], ['İğne', e.igne?.deger],
        ['Ağırlık', e.agirlik?.deger],
      ].filter((r) => r[1]) as [string, string][],
    };
  }),
};

const iller = [...new Set(veri.noktalar.map((n) => n.il))];
const bolgeler = [...new Set(veri.noktalar.map((n) => n.bolge))];
---
<section
  id="hava-panel"
  data-sabit={sabitNokta}
  class="rounded-sm border-2 border-line-strong bg-bg-tint p-4 sm:p-5"
>
  {/* Başlık satırı aynı zamanda panelin araç çubuğu: son yenileme damgası
      düğmelerin hemen yanında durur, "bu veri ne kadar taze" sorusu
      yenileme eylemiyle aynı yerde cevaplanır.

      Dar ekranda başlık ve araç çubuğu ayrı satırlara iner: `flex-wrap` ile
      sarmalayınca damga + düğmeler başlığın altına kayıp sağa yapışıyor,
      kazara olmuş gibi duruyordu. Damga sola, düğmeler sağa hizalı.
      Damga gizliyken düğmeler `justify-end` sayesinde sağda kalır. */}
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
    <h2 class="text-xl sm:text-2xl">{baslikBicimi(baslik)}</h2>
    <div class="flex items-center justify-end gap-2 sm:ml-auto">
      <span data-guncelleme hidden class="sayisal mr-auto text-xs leading-tight text-muted sm:mr-0"></span>
      {!sabitNokta && (
        /* Konum yalnızca bu düğmeye basılınca sorulur; tarayıcı konum
           vermiyorsa düğme hiç görünmez ve seçiciler tek başına yeter. */
        <button
          type="button" data-en-yakin hidden
          class="dugme dugme-birincil dugme-ikon"
          aria-label="Konumuma En Yakın Noktayı Seç"
          title="Konumuma En Yakın Noktayı Seç"
        ><Ikon ad="konum" sinif="size-[18px]" /></button>
      )}
      <button
        type="button" data-yenile
        class="dugme dugme-birincil dugme-ikon"
        aria-label="Havayı Yenile" title="Havayı Yenile"
      ><Ikon ad="yenile" sinif="size-[18px]" /></button>
    </div>
  </div>

  {!sabitNokta && (
    <div class="panel-bolum">
      <h3 class="alt-baslik">Nokta Seçimi</h3>
      <div class="mt-2 grid gap-4 sm:grid-cols-[minmax(0,10rem)_minmax(0,1fr)]">
        <label class="block">
          <span class="etiket-ust">İl</span>
          <select data-il class="alan mt-1.5">
            {iller.map((il) => <option value={il}>{IL_ADLARI[il] ?? il}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="etiket-ust">Nokta</span>
          {/* Sunucu tüm noktaları basar; il seçilince istemci listeyi daraltır. */}
          <select data-secici class="alan mt-1.5">
            {bolgeler.map((b) => (
              <optgroup label={BOLGE_ADLARI[b] ?? b} data-bolge={b}>
                {veri.noktalar.filter((n) => n.bolge === b).map((n) => (
                  <option value={n.id}>{n.ad}</option>
                ))}
              </optgroup>
            ))}
          </select>
        </label>
      </div>
      <p data-konum-durum hidden class="mt-2 text-sm text-warn" role="status"></p>
    </div>
  )}

  {/* Karar kartı — tasarım 1b. Yalnız canlı veriyle anlamlı olduğu için
      `[data-canli]` içinde; veri gelmezse mevsimsel listeye düşülür. */}
  <div data-canli hidden class="panel-bolum">
    <div data-karar></div>
  </div>

  <div class="panel-bolum">
    <h3 class="alt-baslik">Bugünün Koşulları</h3>
    <p data-durum-metni class="mt-2 text-sm text-muted">
      Canlı veri için tarayıcıda JavaScript gerekiyor. Aşağıdaki liste mevsime göre hazırlandı.
    </p>
    <div data-canli hidden>
      <div data-durum class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-3"></div>
      <div data-uyari class="mt-3"></div>
    </div>
  </div>

  <div class="panel-bolum">
    <h3 class="alt-baslik">Bugün Ne Çıkar</h3>
    <div data-canli hidden>
      <ul data-liste class="mt-3 space-y-3"></ul>
      <p class="mt-3 text-xs text-muted">
        Skorlar sezgisel bir tahmindir, garanti değildir. Her satırdaki
        “Skor Nasıl Hesaplandı?” bağlantısı hangi faktörün ne kadar etkilediğini gösterir.
        Veri kaynağı: Open-Meteo.
      </p>
    </div>

    <slot />
  </div>
</section>

<script type="application/json" id="fishfish-veri" set:html={JSON.stringify(veri)} is:inline></script>

<script>
  import { baslat } from '../components/islands/weather-panel';
  // Sayfa geçişinde modül yeniden çalışmaz; kurulumu her yüklemede olay tetikler.
  document.addEventListener('astro:page-load', () => baslat());
</script>
